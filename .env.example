# Copy to .env and replace every REPLACE_ME value with local-only values.
# This template contains placeholders, not credentials or production settings.
POSTGRES_DB=REPLACE_ME_LOCAL_DATABASE
POSTGRES_USER=REPLACE_ME_LOCAL_USER
POSTGRES_PASSWORD=REPLACE_ME_LOCAL_PASSWORD
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# Explicit browser origins for direct cross-origin API access. The Compose
# frontend uses Vite's same-origin proxy and does not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=16384
APP_ENV=development
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=

# Used only when running the API directly on Windows. Replace every
# placeholder; keep the password URL-safe. Compose builds an internal URL.
DATABASE_URL=postgresql+psycopg://REPLACE_ME_LOCAL_USER:REPLACE_ME_LOCAL_PASSWORD@localhost:5432/REPLACE_ME_LOCAL_DATABASE
